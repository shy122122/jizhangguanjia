# =============================================================================
#  明账 · 后台管理系统 环境变量模板
#  用法：复制为 .env 后按本机情况填写。.env 已在 .gitignore 中，不会入库。
#      copy .env.example .env
# =============================================================================

# ----------------------------------------------------------------- 服务
# 建议与 C 端后端错开端口：两个系统必须同时能跑起来，才能做「token 互不通用」的验证。
PORT=3001
NODE_ENV=development
# 直连保持 0；若生产经过一层 Nginx，设为 1，确保 IP 限流读到真实客户端地址。
TRUST_PROXY_HOPS=0

# ----------------------------------------------------------------- 数据库
# 需要 MySQL 8.0.16+（低于此版本 CHECK 约束被静默忽略）
DB_HOST=127.0.0.1
DB_PORT=3306
# 后台专用账号。由 npm run migrate 创建，写权限被收窄到 PRD 3.2 列出的那几列。
# 本地若尚未建号，可临时改成 C 端的 mz_app 先跑通（但它权限更宽，不要用于生产）。
DB_USER=mz_admin
DB_PASSWORD=请填写数据库密码
DB_NAME=mingzhang

# 仅执行 npm run migrate / npm run seed 时使用的高权限账号（需要 CREATE / ALTER / GRANT）。
# 建议临时设在命令行环境里，不要把 root 密码长期写进 .env。
# MIGRATION_DB_USER=root
# MIGRATION_DB_PASSWORD=请填写迁移账号密码

DB_POOL_SIZE=10

# ----------------------------------------------------------------- 认证
# JWT 签名密钥（HS256）。必须与 C 端的密钥**不同**，否则两边 token 可能互相解通。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为随机密钥
# 后台是内部系统，会话应比 C 端短。PRD 4.1 建议 8 小时。
JWT_EXPIRES_IN=8h
# 接近过期就顺手下发新 token（滑动续期）
JWT_RENEW_AFTER=1h

# ----------------------------------------------------------------- 重置密码
# 运营重置用户密码后，新密码怎么交给用户是 PRD 待定问题 #1，尚未决策。
# true  = 生成临时密码并**在响应里回显**，供本地演示走通流程。
# false = 只递增 token_version 强制下线，不产生新密码（生产应走短信/邮件自助重置）。
RESET_PASSWORD_DEV_MODE=true
# 临时密码有效期（分钟）。仅在上面的开关为 true 时有意义。
RESET_PASSWORD_TTL_MINUTES=30

# ----------------------------------------------------------------- 前端
# 静态页目录，相对 backend/ 或绝对路径均可。挂在根路径 / 上。
FRONTEND_DIR=../frontend
