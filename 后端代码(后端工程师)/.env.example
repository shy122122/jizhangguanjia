# =============================================================================
#  明账后端 · 环境变量模板
#  用法：复制为 .env 后按本机情况填写。.env 已在 .gitignore 中，不会入库。
#      copy .env.example .env
# =============================================================================

# ----------------------------------------------------------------- 服务
# HTTP 监听端口；托管前端页面与 API 共用此端口
PORT=3000
NODE_ENV=development
# 直连保持 0；若生产环境恰好经过一层 Nginx/负载均衡，设为 1，确保 IP 限流读取真实客户端地址。
TRUST_PROXY_HOPS=0

# ----------------------------------------------------------------- 数据库
# 需要 MySQL 8.0.16+（低于此版本 CHECK 约束会被静默忽略）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mz_app
DB_PASSWORD=请填写数据库密码
DB_NAME=mingzhang

# 仅执行 npm run migrate:backend-fixes 时使用。生产进程不读取这两个值。
# 建议临时设置在命令行环境中，不要把 root 密码长期写进 .env。
# MIGRATION_DB_USER=root
# MIGRATION_DB_PASSWORD=请填写迁移账号密码

# 连接池上限。个人记账场景并发极低，默认值足够。
DB_POOL_SIZE=10

# ----------------------------------------------------------------- 认证
# JWT 签名密钥（HS256）。必须改成一个足够长的随机串，泄露等于所有人可伪造登录。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为随机密钥
# token 有效期。PRD 4.1.2：登录状态保持 30 天
JWT_EXPIRES_IN=30d
# 距离过期不足这个时间就顺手下发新 token（滑动续期），避免用户用到第 30 天被踢下线
JWT_RENEW_AFTER=1d

# 公共演示账号保护。禁止访客修改演示账号密码或永久注销；生产环境请保持 true。
DEMO_ACCOUNT_PROTECTED=true

# ----------------------------------------------------------------- 短信
# true = 开发模式：验证码直接放在接口响应里返回，不接短信网关。
# 本地没接网关时注册流程根本没法测，所以默认开。
# 生产环境会强制拒绝 true，必须改成 false 并接入真实短信服务。
SMS_DEV_MODE=true

# ----------------------------------------------------------------- 前端
# 静态页目录，相对后端项目根目录或使用绝对路径均可。
# 挂载在根路径 / 上，因为页面里写的是 ../assets/... 相对引用。
FRONTEND_DIR=../前端代码（前端工程师）/fronted/整理版
